#ifndef FILE_SECRETDEFS_SEEN
#define FILE_SECRETDEFS_SEEN

/* Telemetry API: engine runs are POSTed as JSON to <base><path>. */
#define SERVER_BASE_URL         "https://example.com"
#define SERVER_SYNC_PATH        "/api/sensor/sync/runtime"

/* Firmware distribution. Served from its own host - see the OTA section of
 * README.md for the two endpoints and the release procedure. */
#define SERVER_OTA_BASE_URL     "https://static.example.com"
#define SERVER_OTA_LATEST_PATH  "/firmware/sc-022/latest"  /* GET -> preferred version string */
#define SERVER_OTA_IMAGE_PATH   "/firmware/sc-022/"        /* GET <path><version><suffix> -> image */
#define SERVER_OTA_IMAGE_SUFFIX ".bin"                     /* appended to the version identifier */

#endif /* !FILE_SECRETDEFS_SEEN */
