# Override some defaults so BT stack is enabled
# in this example

#
# Main task stack - needs extra room for HTTP+TLS (mbedTLS uses ~8-12KB)
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

#
# BT config
#
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

#
# Flash: ESP32-S3FN8, 8MB embedded
#
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

#
# OTA: two app slots (see partitions.csv). Rollback means a new image boots
# as PENDING_VERIFY and the bootloader reverts to the previous slot unless
# the app calls esp_ota_mark_app_valid_cancel_rollback().
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

#
# Firmware version lives in version.txt at the project root - nothing here.
# CONFIG_APP_PROJECT_VER_FROM_CONFIG must stay off or it overrides that file.
#
